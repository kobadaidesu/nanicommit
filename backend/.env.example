# Supabase PostgreSQL の接続文字列（Project Settings → Database）。バックエンドだけが持つ。
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Web の access token 検証に使う（Project Settings → API）。公開用の anon key で足りる。
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>

# 問題画面（フロント）のURL。CLIが開く quiz_url の先頭部分になる。
WEB_BASE_URL=http://localhost:3000
# バックエンドを呼んでよいフロントの配信元（JSONの配列）。開発中は Next.js(3000) と Vite(5173) の両方を許可。
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# fake: 固定の3問（MCP 不要） / mcp: app/learning/generate.py（MCP Server 経由で Gemini）を使う
QUIZ_GENERATOR=fake
GENERATION_TIMEOUT_SECONDS=30

# QUIZ_GENERATOR=mcp のときだけ必要。MCP Server（app/learning/mcp_server.py）が Gemini を呼ぶのに使う。
# Google AI Studio の API キー。
GOOGLE_API_KEY=<Google AI Studio の API キー>
# 使うモデルを変えるときだけ設定する（未設定なら mcp_server.py の既定値 gemini-3.8-flash）。
# GEMINI_MODEL=gemini-3.8-flash
